# Example environment variables for Criconnnect
# Copy to .env and update values before running in production

# Backend
MONGODB_URI=mongodb://mongo:27017/cricket-intelligence
PORT=5000

# Auth
JWT_SECRET=your_jwt_secret_here

# Other optional variables
NODE_ENV=production

# Frontend
# If serving via nginx in container, frontend listens on port 80 inside container
FRONTEND_PORT=80
